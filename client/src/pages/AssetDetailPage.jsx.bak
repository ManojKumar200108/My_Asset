import React, { useEffect, useState } from 'react';
import { Link, useParams } from 'react-router-dom';
import { api } from '../contexts/AuthContext';

const fmtCurrency = (value) =>
  new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(
    Number(value || 0)
  );
const fmtDate = (value) =>
  value
    ? new Date(value).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })
    : '-';

export default function AssetDetailPage() {
  const { id } = useParams();
  const [asset, setAsset] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  useEffect(() => {
    let mounted = true;
    const load = async () => {
      try {
        const res = await api.get(`/data/assets/${id}`);
        if (mounted) setAsset(res.data.data);
      } catch (err) {
        if (mounted) setError(err.response?.data?.message || 'Failed to load asset');
      } finally {
        if (mounted) setLoading(false);
      }
    };
    load();
    return () => { mounted = false; };
  }, [id]);

  if (loading) return <div className="card"><div className="card-body">Loading asset details...</div></div>;
  if (error) return <div className="card"><div className="card-body">{error}</div></div>;
  if (!asset) return null;

  return (
    <div>
      <div style={{ marginBottom: 12 }}>
        <Link to="/assets">Assets</Link> / <span>{asset.assetId}</span>
      </div>
      <div className="card mb-4">
        <div className="card-body">
          <h3>{asset.assetName}</h3>
          <div>ID: {asset.assetId}</div>
          <div>Category: {asset.category?.name || '-'}</div>
          <div>Status: {asset.status?.name || '-'}</div>
          <div>Plant: {asset.plant?.name || '-'}</div>
          <div>Location: {asset.location?.name || '-'}</div>
          <div>Department: {asset.department?.name || '-'}</div>
          <div>Purchase Cost: {fmtCurrency(asset.purchaseCost)}</div>
          <div>Book Value: {fmtCurrency(asset.currentBookValue)}</div>
          <div>Purchase Date: {fmtDate(asset.purchaseDate)}</div>
        </div>
      </div>

      <div className="card mb-4">
        <div className="card-header"><span className="card-title">History</span></div>
        <div className="card-body">
          {(asset.history || []).map((h) => (
            <div key={h.id} style={{ marginBottom: 8 }}>
              <strong>{h.fieldName}</strong>: {h.oldValue || '-'} to {h.newValue || '-'} by {h.changedBy?.name || '-'} on {fmtDate(h.changedAt)}
            </div>
          ))}
          {(!asset.history || asset.history.length === 0) && <div>No history records.</div>}
        </div>
      </div>
    </div>
  );
}


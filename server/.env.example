# Database
DATABASE_URL="postgresql://user:password@localhost:5432/industrial_assets"

# JWT
JWT_SECRET="your-secret-key-here-change-in-production"
JWT_EXPIRES_IN="7d"

# Email (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@industrialassets.com"

# Server
PORT=3000
NODE_ENV="development"

# Client URL
CLIENT_URL="http://localhost:5173"

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH="./uploads"
